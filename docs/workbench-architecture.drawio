        <mxCell id="a6" value="失败后修复" source="gates" target="candidate" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;exitX=0;exitY=0.5;entryX=0;entryY=0.5;dashed=1;">
