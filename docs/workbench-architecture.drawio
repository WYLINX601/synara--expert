  <diagram name="02 每周集成与安装" id="02 每周集成与安装">
    <mxGraphModel dx="1200" dy="1160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="每周检查一次：候选验证通过后更新日用版" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="20" width="1080" height="55" />
        </mxCell>
        <mxCell id="upstream" value="官方最新稳定版&#10;锁定 tag 与完整 SHA" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="110" width="460" height="100" />
        </mxCell>
        <mxCell id="ours" value="我们的已验证版本&#10;Synara + 自定义能力" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="670" y="110" width="460" height="100" />
        </mxCell>
        <mxCell id="candidate" value="独立同步工作区&#10;合并官方变化 / 处理冲突与接口适配" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="295" width="760" height="105" />
        </mxCell>
        <mxCell id="gates" value="自动检查 + 隔离运行验证&#10;原生能力 / 专家 / 数据升级 / 看板关联" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="495" width="760" height="105" />
        </mxCell>
        <mxCell id="release" value="已验证的工作台构建&#10;记录两个源码 SHA 与 schema 版本" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="695" width="760" height="105" />
        </mxCell>
        <mxCell id="install" value="空闲时安装到日用工作台&#10;自己的应用身份、数据目录和更新渠道" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="220" y="895" width="760" height="105" />
        </mxCell>
        <mxCell id="foot" value="失败时保留原日用版并继续修复候选。回退涉及不兼容数据迁移时，需恢复配套数据备份。&#10;本图描述目标流程；定时任务、分支合并和生产安装尚未配置。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1040" width="1000" height="70" />
        </mxCell>
        <mxCell id="a1" value="每周取一次快照" source="upstream" target="candidate" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;entryX=0.25;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a2" value="保留自定义代码" source="ours" target="candidate" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;entryX=0.75;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a3" value="" source="candidate" target="gates" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a4" value="通过" source="gates" target="release" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="a5" value="一致性备份 / 已授权安装" source="release" target="install" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=13;">
