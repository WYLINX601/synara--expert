<mxfile host="app.diagrams.net" version="32.4.1"><diagram id="hub-tech-v08" name="协作架构"><mxGraphModel dx="1200" dy="1020" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1020"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Hub 协作 Graph · 技术架构提案&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=28;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="25" width="1080" height="45" /></mxCell><mxCell id="subtitle" value="V0.8 产品基线｜业务编排新增，任务、队列、线程与 Provider 复用宿主" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=15;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="75" width="1080" height="30" /></mxCell><mxCell id="graph" value="&lt;b&gt;Graph 状态看板&lt;/b&gt;&lt;br&gt;阶段 · 进度 · 详情导航&lt;br&gt;只读，不发送执行命令" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="160" width="280" height="100" /></mxCell><mxCell id="card" value="&lt;b&gt;消息流操作卡&lt;/b&gt;&lt;br&gt;确认 · 回复 · 放行 · 退回&lt;br&gt;不可变内容 + 操作回执" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="160" width="280" height="100" /></mxCell><mxCell id="settings" value="&lt;b&gt;专家团 / Hub 设置&lt;/b&gt;&lt;br&gt;成员 · 协调方式 · 来源版本&lt;br&gt;草稿与冲突保护" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="160" width="280" height="100" /></mxCell><mxCell id="projection" value="&lt;b&gt;一致投影与事件&lt;/b&gt;&lt;br&gt;快照 · 持久序号 · 历史卡片&lt;br&gt;阶段由有效事实派生" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="355" width="280" height="110" /></mxCell><mxCell id="commands" value="&lt;b&gt;计划与出口命令&lt;/b&gt;&lt;br&gt;版本授权 · 当前候选 · 用户决定&lt;br&gt;事务 / CAS / 回执 / outbox" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="355" width="280" height="110" /></mxCell><mxCell id="config" value="&lt;b&gt;配置与快照&lt;/b&gt;&lt;br&gt;预设 → Hub 副本 → 运行快照&lt;br&gt;权限和凭证仍实时校验" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="355" width="280" height="110" /></mxCell><mxCell id="task" value="&lt;b&gt;ProjectGoal / Task&lt;/b&gt;&lt;br&gt;原子业务状态 · 依赖 · Attempt&lt;br&gt;证据与版本成果引用" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="560" width="280" height="110" /></mxCell><mxCell id="work" value="&lt;b&gt;HubWork / 命令准入&lt;/b&gt;&lt;br&gt;提交 · 排队 · 派发 · 续跑&lt;br&gt;复核授权、出口、暂停和输入" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="560" width="280" height="110" /></mxCell><mxCell id="runtime" value="&lt;b&gt;Thread / Provider&lt;/b&gt;&lt;br&gt;原会话 · 执行 · 中断 · 恢复&lt;br&gt;运行结束不等于业务放行" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="860" y="560" width="280" height="110" /></mxCell><mxCell id="db" value="&lt;b&gt;原生 Task / HubWork / 成果记录  +  协作扩展表&lt;/b&gt;&lt;br&gt;计划版本 · 配置快照 · 轮次 / 候选 · 审核 / 决定 · 事件 / 回执 / outbox&lt;br&gt;任务依赖一处可写；扩展使用既有 Workbench 迁移账本" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="780" width="1080" height="120" /></mxCell><mxCell id="e1" value="状态 / 历史" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="projection" target="graph"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="用户命令" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="card" target="commands"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="配置保存" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="settings" target="config"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="同一事实" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="commands" target="projection"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="固定版本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="config" target="commands"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="可靠转交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="commands" target="work"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="依赖 / 证据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="task" target="work"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="原生执行链路" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work" target="runtime"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="原有记录" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.13;entryY=0;" edge="1" parent="1" source="task" target="db"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="原子提交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.85;exitY=1;entryX=0.97;entryY=0;" edge="1" parent="1" source="commands" target="db"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="800" y="495" /><mxPoint x="1170" y="495" /><mxPoint x="1170" y="735" /><mxPoint x="1108" y="735" /></Array></mxGeometry></mxCell><mxCell id="e11" value="读" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#54635f;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="db" target="projection"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="20" y="840" /><mxPoint x="20" y="410" /></Array></mxGeometry></mxCell><mxCell id="note" value="实线：命令 / 数据依赖   虚线：读取投影   ｜   技术评审稿，尚未实施；不新增第二套执行器" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;spacing=14;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=14;align=left;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="930" width="1080" height="40" /></mxCell></root></mxGraphModel></diagram></mxfile>