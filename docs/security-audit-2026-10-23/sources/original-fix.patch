+      tasks.push(
+        yield* service.createTask(
+          { requestId: `req-concurrent-deps-${title}`, projectId: groupId, goalId: goal.id, title },
+          { kind: "user" },
+        ),
+      );
+    }
+    const [first, second] = tasks;
+    const readEdges = repository.listTaskEdges;
+    // Suspend after each real SQLite snapshot. Without command serialization,
+    // both requests validate the same empty graph before either edge is saved.
+    Object.assign(repository, {
+      listTaskEdges: (projectId: ProjectId) =>
+        readEdges(projectId).pipe(Effect.tap(() => Effect.sleep("1 millis"))),
